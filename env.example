# API Configuration
APP_NAME="Auto Clipper API"
APP_VERSION="1.0.0"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

# OpenAI Configuration (Required)
OPENAI_API_KEY="your_openai_api_key_here"

# ZapCap Configuration (Optional)
ZAPCAP_API_KEY="your_zapcap_api_key_here"
ZAPCAP_TEMPLATE_ID="your_default_template_id"
ZAPCAP_API_BASE="https://api.zapcap.ai"

# Storage Configuration
UPLOAD_DIR="data/uploads"
CLIPS_DIR="data/clips"
TEMP_DIR="data/temp"
RESULTS_DIR="data/results"

# Processing Configuration
MAX_FILE_SIZE=524288000  # 500MB in bytes
MAX_CLIP_DURATION=120    # seconds
MIN_CLIP_DURATION=10     # seconds
MAX_TRANSCRIPTION_CHUNK_SIZE=20971520  # 20MB in bytes
MAX_CONCURRENT_CHUNKS=5

# Video Processing Configuration
DEFAULT_ASPECT_RATIO="9:16"
FFMPEG_PRESET="fast"
VIDEO_QUALITY_CRF=23

# Instagram Configuration (Optional - for content analyzer)
INSTAGRAM_USERNAME="your_instagram_username"
INSTAGRAM_PASSWORD="your_instagram_password"

# TikTok API Configuration (Optional)
TIKTOK_API_KEY="your_tiktok_api_key"
TIKTOK_API_SECRET="your_tiktok_api_secret"
TIKTOK_ACCESS_TOKEN="your_tiktok_access_token"

# Instagram Graph API Configuration (Optional)
INSTAGRAM_API_KEY="your_instagram_api_key"
INSTAGRAM_API_SECRET="your_instagram_api_secret"
INSTAGRAM_ACCESS_TOKEN="your_instagram_access_token"

# YouTube API Configuration (Optional)
YOUTUBE_API_KEY="your_youtube_api_key"
YOUTUBE_CLIENT_ID="your_youtube_client_id"
YOUTUBE_CLIENT_SECRET="your_youtube_client_secret"
YOUTUBE_REFRESH_TOKEN="your_youtube_refresh_token"

# Path to YOLOv8 face detection weights (recommended: keremberke/yolov8n-face)
YOLOV8_FACE_WEIGHTS=backend/data/models/yolov8n-face.pt 